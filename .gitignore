.DS_Store
.AppleDouble
.LSOverride

# Obsidian workspace state (open tabs, cursor position, etc.)
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# Secrets — LinkedIn API credentials live here
00 System/scripts/linkedin/.env
00 System/scripts/linkedin/.tokens.json
__pycache__/
*.pyc

# Content folder — all drafts, published posts, and performance logs
# stay local in Obsidian; only system/functionality belongs in git
05 Content/